---
import '../styles/global.css';
import Reseaux from '../components/Reseaux.astro';
import {
  CONSORTIUM as CONSORTIUM_RESEAUX,
  NDIEUMBEUTT as NDIEUMBEUTT_RESEAUX,
  TOUS,
} from '../reseaux';

interface Props {
  titre: string;
  description: string;
  /** Rendu du bloc schema.org Organisation. Page d'accueil uniquement. */
  organisation?: boolean;
  /** Carte de partage propre a la page. Chemin absolu depuis la racine. */
  image?: string;
  /** `article` sur une actualite : Facebook et WhatsApp en tiennent compte. */
  ogType?: 'website' | 'article';
  /** Bloc JSON-LD supplementaire, deja serialise. */
  schemaSupplementaire?: string;
}

const {
  titre,
  description,
  organisation = false,
  image = '/partage.png',
  ogType = 'website',
  schemaSupplementaire,
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site);
const partage = new URL(image, Astro.site);

// Les six rubriques sont de vraies pages depuis le 10/08. L'accueil garde son
// defilement complet et sert de resume : chaque section s'y termine par un lien
// vers sa page. C'est ainsi que fonctionnent Farm Africa et One Acre Fund.
const rubriques = [
  // 🔄 LIBELLE CHANGE LE 15/08 : « Qui sommes-nous » devient « Notre histoire ».
  // C'est la demande de Laye du 14/08, et Saibo a tranche qu'elle ne cree PAS
  // une page de plus — c'est cette page-ci qui la porte. L'ADRESSE, ELLE, NE
  // BOUGE PAS : le lien du site circule sur WhatsApp depuis le 12/08, et casser
  // une URL deja partagee couterait plus que le confort d'une adresse assortie.
  { url: '/qui-sommes-nous/', nom: 'Notre histoire' },
  { url: '/programmes/', nom: 'Nos programmes' },
  { url: '/impact/', nom: 'Notre impact' },
  { url: '/actualites/', nom: 'Actualités' },
  // 🆕 Galerie, demandee par Laye le 14/08. Placee ici et non en fin de menu :
  // c'est du contenu, elle appartient au voisinage des actualites, pas a celui
  // des partenaires et du contact.
  { url: '/galerie/', nom: 'Galerie' },
  { url: '/partenaires/', nom: 'Partenaires' },
  { url: '/contact/', nom: 'Contact' },
];

// Marque la rubrique courante. `startsWith` et non egalite stricte : /actualites/
// doit rester active pendant la lecture de /actualites/un-article/.
const ici = Astro.url.pathname;
const estActive = (url: string) => ici.startsWith(url);

// Coordonnees officielles : FICHE-CLIENT.md, section « Coordonnees officielles ».
// C'est la seule source. Le squelette portait un numero errone (77 236 81 62).
const CONSORTIUM = {
  tel: '+221 77 267 25 10',
  telUrl: '+221772672510',
  email: 'consortiumdekkandoo@gmail.com',
  lieu: 'Saint-Louis, Sénégal',
};
const NDIEUMBEUTT = {
  tel: '+221 70 923 69 70',
  telUrl: '+221709236970',
  email: 'ndieumbeutt.dekkandoo@gmail.com',
  lieu: 'Rao, Saint-Louis',
};

// Les comptes vivent dans src/reseaux.ts — source unique partagee avec la
// section Contact et le schema.org.


// schema.org : c'est ce qui fait qu'un moteur comprend « organisation reelle »
// et non « page web ». Les deux graphies du nom sont declarees — beaucoup
// ecriront « Dekkandoo » sans trema.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Consortium Dëkkandoo',
  alternateName: ['Consortium Dekkandoo', 'Dëkkandoo', 'Dekkandoo'],
  url: Astro.site?.href,
  logo: new URL('/logo/logo-dekkandoo-512.png', Astro.site).href,
  description:
    "Le Consortium Dëkkandoo agit dans les six communes du département de Saint-Louis pour la nutrition infantile, l'accès aux soins et l'autonomisation économique des femmes.",
  email: CONSORTIUM.email,
  telephone: CONSORTIUM.tel,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Saint-Louis',
    addressCountry: 'SN',
  },
  areaServed: 'Département de Saint-Louis, Sénégal',
  sameAs: TOUS,
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre} &mdash; Consortium Dëkkandoo</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Consortium Dëkkandoo" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={`${titre} — Consortium Dëkkandoo`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={partage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Consortium Dëkkandoo — six communes du département de Saint-Louis"
    />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" sizes="64x64" href="/logo/favicon-64.png" />
    <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />
    {/* Suit `--color-forest`. C'est la couleur que Chrome sur Android peint
        autour de la page : desaccordee, elle se voit sur le seul appareil
        depuis lequel ce site sera vraiment consulte. */}
    <meta name="theme-color" content="#165a2d" />

    {
      organisation && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      )
    }
    {
      schemaSupplementaire && (
        <script type="application/ld+json" set:html={schemaSupplementaire} />
      )
    }

    <!-- Pose la classe `js` avant le rendu : c'est elle qui autorise l'etat
         cache des sections. Sans JavaScript, la regle CSS ne s'applique jamais
         et tout reste visible. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-forest focus:px-4 focus:py-2 focus:text-paper"
    >
      Aller au contenu
    </a>

    {/*
      EN-TETE — deux tenues selon la largeur, et c'est l'arbitrage de Saibo le
      11/08 : les six rubriques restent VISIBLES sur ordinateur, le bouton a
      trois barres ne sert que sur telephone. C'est le bon sens pour un site
      qu'un bailleur consulte : cacher « Notre impact » derriere un clic sur un
      grand ecran ne fait gagner que de la place dont on dispose.

      Le menu du telephone est bati sur `<details>` et non sur un script :
      l'ouverture, la fermeture et le clavier sont assures par le navigateur, et
      il reste utilisable JavaScript coupe — comme le reste de ce site.

      Reseaux et telephone figurent des DEUX cotes : dans la barre sur
      ordinateur, dans le panneau sur telephone.
    */}
    <header class="entete">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-4">
        <a href="/" class="flex shrink-0 items-center" aria-label="Consortium Dëkkandoo, accueil">
          {/* DEUX LOGOS, ET UN SEUL S'AFFICHE A LA FOIS. Le logo en vraies
              couleurs sert partout ; la version blanche ne sort que lorsque la
              barre flotte sur le film de l'ecran d'intro (classe `sur-film`,
              posee par le script de l'accueil).

              Les deux sont dans le balisage et c'est le CSS qui choisit : un
              echange de `src` en JavaScript aurait fait clignoter le logo a
              chaque bascule, le temps que la seconde image se telecharge. Ici
              les deux sont deja la. Le brun du logo mesure 1,02:1 sur le vert
              et se perd tout autant sur une image sombre — la version blanche
              n'est donc pas un gout, c'est la meme regle que partout. */}
          <img
            src="/logo/logo-dekkandoo-256.png"
            alt="Consortium Dëkkandoo"
            width="112"
            height="92"
            class="entete-logo-couleur h-12 w-auto lg:h-[4.5rem]"
          />
          <img
            src="/logo/logo-dekkandoo-blanc-512.png"
            alt=""
            aria-hidden="true"
            width="112"
            height="92"
            class="entete-logo-blanc h-12 w-auto lg:h-[4.5rem]"
          />
        </a>

        {/* Barre d'ordinateur */}
        <div class="entete-bureau">
          <nav aria-label="Navigation principale">
            <ul class="entete-liens">
              {
                rubriques.map(({ url: lien, nom }) => (
                  <li>
                    <a href={lien} aria-current={estActive(lien) ? 'page' : undefined}>
                      {nom}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <span class="entete-filet" aria-hidden="true"></span>

          {/* `class` sert de crochet pour l'etat « barre sur le film » : le
              composant genere des classes utilitaires, sans nom stable a viser. */}
          <Reseaux
            comptes={CONSORTIUM_RESEAUX}
            entite="Consortium Dëkkandoo"
            ton="sombre"
            compact
            class="entete-reseaux"
          />

          <a href={`tel:${CONSORTIUM.telUrl}`} class="entete-tel">{CONSORTIUM.tel}</a>
        </div>

        {/* Menu du telephone */}
        <details class="menu">
          <summary class="menu-bouton" aria-label="Ouvrir le menu">
            <span class="menu-barres" aria-hidden="true"><i></i><i></i><i></i></span>
          </summary>

          <div class="menu-panneau">
            <div class="menu-contenu">
              <nav aria-label="Navigation principale">
                <ul class="menu-liste">
                  {
                    rubriques.map(({ url: lien, nom }) => (
                      <li>
                        <a href={lien} aria-current={estActive(lien) ? 'page' : undefined}>
                          {nom}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </nav>

              <a href={`tel:${CONSORTIUM.telUrl}`} class="menu-tel">
                Appeler le {CONSORTIUM.tel}
              </a>

              <Reseaux
                comptes={CONSORTIUM_RESEAUX}
                entite="Consortium Dëkkandoo"
                ton="sombre"
                class="justify-center"
              />
            </div>
          </div>
        </details>
      </div>
    </header>

    <main id="contenu" class="flex-1">
      <slot />
    </main>

    <footer class="bg-forest text-paper">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-4">
        <div class="lg:col-span-2">
          <img
            src="/logo/logo-dekkandoo-blanc-512.png"
            alt=""
            width="160"
            height="132"
            class="h-16 w-auto"
          />
          <p class="mt-5 max-w-sm text-sm leading-relaxed text-paper/75">
            Dëkkandoo signifie « le voisinage ». Les communautés ne sont pas les
            bénéficiaires de nos projets, elles en sont les actrices.
          </p>
        </div>

        <div class="text-sm">
          <p class="font-serif text-base">Consortium Dëkkandoo</p>
          <p class="mt-1 text-xs uppercase tracking-wide text-paper/55">Siège</p>
          <ul class="mt-3 space-y-1 text-paper/85">
            <li><a href={`tel:${CONSORTIUM.telUrl}`} class="hover:underline">{CONSORTIUM.tel}</a></li>
            <li>
              <a href={`mailto:${CONSORTIUM.email}`} class="break-all hover:underline">
                {CONSORTIUM.email}
              </a>
            </li>
            <li class="text-paper/70">{CONSORTIUM.lieu}</li>
          </ul>
          <Reseaux
            comptes={CONSORTIUM_RESEAUX}
            entite="Consortium Dëkkandoo"
            ton="clair"
            class="mt-4"
          />
        </div>

        <div class="text-sm">
          <p class="font-serif text-base">Projet Ndieumbeutt</p>
          <p class="mt-1 text-xs uppercase tracking-wide text-paper/55">Antenne</p>
          <ul class="mt-3 space-y-1 text-paper/85">
            <li><a href={`tel:${NDIEUMBEUTT.telUrl}`} class="hover:underline">{NDIEUMBEUTT.tel}</a></li>
            <li>
              <a href={`mailto:${NDIEUMBEUTT.email}`} class="break-all hover:underline">
                {NDIEUMBEUTT.email}
              </a>
            </li>
            <li class="text-paper/70">{NDIEUMBEUTT.lieu}</li>
          </ul>
          <Reseaux
            comptes={NDIEUMBEUTT_RESEAUX}
            entite="Projet Ndieumbeutt"
            ton="clair"
            class="mt-4"
          />
        </div>
      </div>

      <div class="border-t border-paper/20">
        <p class="mx-auto max-w-6xl px-5 py-5 text-xs text-paper/60">
          &copy; {new Date().getFullYear()} Consortium Dëkkandoo. Saint-Louis, Sénégal.
        </p>
      </div>
    </footer>

    <!-- L'unique geste d'animation du site (regle n.2 du cahier de references).
         IntersectionObserver, une seule fois par element, puis on cesse de
         l'observer : rien ne tourne en continu sur le telephone du visiteur. -->
    <script is:inline>
      const cibles = document.querySelectorAll('.revele');
      if (cibles.length && 'IntersectionObserver' in window) {
        const guetteur = new IntersectionObserver(
          (entrees) => {
            for (const e of entrees) {
              if (e.isIntersecting) {
                e.target.classList.add('vu');
                guetteur.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px' }
        );
        cibles.forEach((c) => guetteur.observe(c));
      } else {
        cibles.forEach((c) => c.classList.add('vu'));
      }
    </script>
  </body>
</html>
