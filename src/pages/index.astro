---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Feuilles from '../components/Feuilles.astro';
import { ACTUALITES } from '../actualites';
import Carrousel from '../components/Carrousel.astro';

// Tout le contenu de cette page vient de MAQUETTE-SITE.html (01/08), la version
// montree au client, elle-meme tiree de FICHE-CLIENT.md et de leurs documents.
// Aucun chiffre n'est invente ici : chacun est deja dans leur matiere.
//
// REFONTE 11/2026 (branche refonte-2026-11) : releve des signes « IA » du 06/11
// et references validees par Saibo (Tostan, GiveDirectly, One Acre Fund,
// Farm Africa). Le contenu ne change pas ; la mise en scene, si.

// Les trois domaines, a la maniere de Tostan : une photo de leur galerie, un
// aplat de couleur, un seul chiffre quand il existe. Les photos sont decrites
// d'apres ce qu'elles MONTRENT, sans affirmer un evenement inverifiable.
const domaines = [
  {
    titre: 'Nutrition infantile',
    chiffre: '20',
    unite: 'sites de suivi communautaire',
    texte:
      'Pesées mensuelles des enfants de 0 à 59 mois, dépistage de la malnutrition, causeries et visites à domicile par des relais qui vivent dans le quartier.',
    photo: 'g63',
    l: 1400,
    h: 1400,
    cadrage: 'object-[50%_30%]',
    alt: 'Deux relais en t-shirt du programme de nutrition, sur le terrain',
    fond: 'bg-forest',
    lien: '/programmes/',
  },
  {
    titre: 'Accès aux soins',
    chiffre: '',
    unite: '',
    texte:
      'Rapprocher les familles des postes de santé, avec l’initiative Diapalanté Fadju et la mutuelle de santé, en appui aux Comités de Développement de Santé.',
    photo: 'g82',
    l: 1400,
    h: 932,
    cadrage: 'object-[40%_50%]',
    alt: 'Un encadrant devant le mur peint du FIPSE, « L’eau c’est la vie »',
    fond: 'bg-leaf',
    lien: '/qui-sommes-nous/',
  },
  {
    titre: 'Autonomisation des femmes',
    chiffre: '400',
    unite: 'femmes de 18 à 35 ans accompagnées',
    texte:
      'Des activités choisies par les femmes, en agriculture, en élevage ou en transformation, financées par les associations villageoises d’épargne et de crédit.',
    photo: 'g37',
    l: 1400,
    h: 933,
    cadrage: 'object-[45%_40%]',
    alt: 'Femmes en tablier et masque pendant une séance de transformation',
    fond: 'bg-earth',
    lien: '/programmes/',
  },
];
---

<Base
  titre="Accueil"
  description="Le Consortium Dëkkandoo agit dans les six communes du département de Saint-Louis pour la nutrition infantile, l'accès aux soins et l'autonomisation économique des femmes."
  organisation
>
  {/* ---------------------------------------------------------------------------
      HEROS PLEIN ECRAN — 08/11/2026, demande de Saibo : « Hero plein ecran ».
      Ni carrousel (signe de gabarit, releve du 06/11) ni montage motion design :
      une boucle MUETTE de 15 s tiree de LEUR film (VIDEO FINALE V1.mp4, plans
      calmes sans interview : fleuve, pesee d'un bebe, enfants, farine, femmes
      qui portent, village vu du ciel), comme One Acre Fund et Farm Africa.

      Le poids est tenu par trois regles :
        · l'image d'attente (premier plan de la boucle) s'affiche TOUJOURS, tout
          de suite ; c'est elle que voit un telephone ;
        · la video n'est demandee qu'a partir de 768 px, si le visiteur n'a ni
          reduit les animations ni active l'economie de donnees (decision du
          11/08 : rien ne bouge sur le heros mobile) ;
        · 720p (2,2 Mo) jusqu'a 1440 px de large, 1080p (4 Mo) au-dela.
      Le titre ne change pas (slogan valide par le client). Aucun son : la video
      est muette, la regle « aucune musique » tient d'elle-meme.
      --------------------------------------------------------------------------- */}
  <section class="heros relative isolate flex min-h-[calc(100svh-6rem)] items-end overflow-hidden bg-forest text-paper">
    <img
      src="/video/heros-affiche-1920.webp"
      srcset="/video/heros-affiche-1080.webp 1080w, /video/heros-affiche-1920.webp 1920w"
      sizes="100vw"
      width="1920"
      height="1080"
      alt=""
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <video
      class="heros-video absolute inset-0 -z-20 h-full w-full object-cover opacity-0 transition-opacity duration-700"
      data-src-moyen="/video/heros-720.mp4"
      data-src-grand="/video/heros-1080.mp4"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"></video>
    {/* Voile du bas et de la gauche : le texte creme reste lisible sur
        n'importe quel plan, le haut de l'image reste clair. */}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#0b1d12]/85 via-[#0b1d12]/35 to-transparent"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#0b1d12]/55 to-transparent"></div>

    <div class="heros-panneau mx-auto w-full max-w-6xl px-5 pb-14 pt-32 sm:pb-20 lg:pb-24">
      <h1 class="max-w-5xl font-titre text-4xl font-semibold leading-[1.06] tracking-[-0.015em] sm:text-5xl lg:text-6xl xl:text-7xl">
        Nous nourrissons l’espoir,<br />
        Nous nourrissons <em class="heros-accent not-italic text-[#e0a94a]">l’avenir.</em>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-paper/90">
        Le Consortium Dëkkandoo agit dans les six communes du département de
        Saint-Louis pour que chaque enfant reçoive un bon départ dans la vie, et
        que chaque femme dispose des moyens de son autonomie.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#programmes"
          class="rounded-full bg-paper px-7 py-3 font-medium text-forest transition-colors hover:bg-paper-2"
        >
          Découvrir nos programmes
        </a>
        <a
          href="/contact/"
          class="rounded-full border border-paper/60 px-7 py-3 font-medium text-paper transition-colors hover:border-paper hover:bg-paper/10"
        >
          Nous contacter
        </a>
      </div>
    </div>
  </section>

  {/* BANDEAU AMPHI — 06/11. Renvoie a l'actualite (pas de video sur l'accueil,
      choix de Saibo). Se masque seul a partir du 12/11, heure du Senegal ; sans
      JavaScript il reste visible : a retirer du code apres l'evenement. */}
  <a href="/actualites/amphi-rentree-nutritionnelle-rao-2026/" class="group block bg-forest text-paper" data-jusqu-au="2026-11-12">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-5 py-5">
      <span class="font-mono text-xs uppercase tracking-[0.2em] text-paper/75">Événement · 11 novembre 2026 · 16 h</span>
      <span class="font-titre text-lg font-semibold sm:text-xl">Amphi de rentrée nutritionnelle à l’école élémentaire de Rao</span>
      <span class="ml-auto text-sm text-paper/85 transition-transform group-hover:translate-x-1">Lire l’annonce →</span>
    </div>
  </a>

  {/* BANDEAU EVENEMENT — 24/09. Un seul lien vers la page des Ndieumbeutt
      Awards : c'est elle qui porte le film et qu'on partage. A retirer apres
      le 17/12/2026. */}
  <a href="/ndieumbeutt-awards/" class="group block bg-[#050805] text-paper" data-a-partir-du="2026-11-12">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-5 py-5">
      <span class="font-mono text-xs uppercase tracking-[0.2em] text-paper/75">Événement · 17 décembre 2026</span>
      <span class="font-titre text-lg font-semibold sm:text-xl">Ndieumbeutt Awards 2026 — célébrons nos championnes</span>
      <span class="ml-auto text-sm text-paper/85 transition-transform group-hover:translate-x-1">Voir le film →</span>
    </div>
  </a>
  {/* REFONTE 11/2026 : un seul bandeau a la fois (releve du 06/11, signe n.7).
      L'amphi jusqu'au 11/11 au soir, les Awards a partir du 12/11, heure du
      Senegal (= UTC). Sans JavaScript, les deux restent visibles. */}
  <script is:inline>
    const maintenant = Date.now();
    const jour = (d) => Date.parse(d + 'T00:00:00Z');
    document.querySelectorAll('[data-jusqu-au]').forEach((b) => {
      if (maintenant >= jour(b.dataset.jusquAu)) b.remove();
    });
    document.querySelectorAll('[data-a-partir-du]').forEach((b) => {
      if (maintenant < jour(b.dataset.aPartirDu)) b.remove();
    });
  </script>


  {/* ---------------------------------------------------------------------------
      REFONTE 11/2026 — L'ACCUEIL RACONTE AU LIEU D'EMPILER (releve du 06/11).
      Le fil vient de Farm Africa : une question, puis la reponse, puis les
      gens. Les trois domaines suivent Tostan : une grande photo, un aplat de
      couleur, un seul chiffre quand il existe. Plus de sur-titre en capitales,
      plus de cartes numerotees « AXE 01 ».
      --------------------------------------------------------------------------- */}
  {/* LE RECIT AU DEFILEMENT — Farm Africa, valide par Saibo le 06/11.
      Trois phrases qui arrivent l'une apres l'autre pendant que la photo reste
      en place (grand ecran). Un seul mot en couleur, « ensemble ».

      LEGER PAR CONSTRUCTION : zero JavaScript, zero octet de plus. L'effet
      passe par les animations liees au defilement du CSS (`animation-timeline:
      view()`). Un navigateur qui ne les connait pas, ou un visiteur qui a
      demande moins d'animation, voit les trois phrases deja en place : la page
      est complete au repos. Public mobile, donnees payantes (regle n.25). */}
  <section id="qui" class="recit relative scroll-mt-24 bg-paper py-16 sm:py-24">
    <Feuilles class="right-4 top-6 w-20 sm:right-10 sm:w-28" />
    <div class="mx-auto grid max-w-6xl gap-10 px-5 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="recit-photo lg:sticky lg:top-28">
          <Photo
            cle="recolte-tomates"
            tailles="(min-width: 1024px) 40vw, 100vw"
            class="aspect-[4/5] w-full rounded-lg object-cover object-[50%_40%] max-lg:aspect-[3/2]"
          />
          <p class="mt-3 text-sm text-ink-3">Récolte de tomates dans une parcelle maraîchère.</p>
        </div>
      </div>
      <div class="lg:col-span-7">
        <p class="recit-temps font-serif text-3xl leading-snug text-forest sm:text-5xl sm:leading-[1.15] lg:flex lg:min-h-[70vh] lg:items-center">
          À Saint-Louis, la malnutrition freine encore la croissance des enfants,
          leurs résultats à l’école et leur santé.
        </p>
        <p class="recit-temps mt-12 font-serif text-2xl leading-snug text-ink sm:text-4xl sm:leading-[1.2] lg:mt-0 lg:flex lg:min-h-[60vh] lg:items-center">
          Un enfant mal nourri est presque toujours l’enfant d’un ménage sans
          revenu stable, loin d’un poste de santé.
        </p>
        <p class="recit-temps mt-12 font-serif text-2xl leading-snug text-ink sm:text-4xl sm:leading-[1.2] lg:mt-0 lg:flex lg:min-h-[60vh] lg:items-center">
          <span>
            Dëkkandoo, « le voisinage », réunit les organisations qui
            travaillaient déjà sur le terrain pour traiter ces trois problèmes
            <em class="not-italic text-accent">ensemble</em>, dans les six
            communes du département.
          </span>
        </p>
      </div>
    </div>
  </section>

  {/* Le ruban brun-vert-ocre de la presentation envoyee a Khaly (07/11), a la
      place de la bande tissee. En CSS : 0 octet d'image. */}
  <div class="bande-tissee" aria-hidden="true"></div>

  <section aria-label="Nos trois domaines d’action" class="grid md:grid-cols-3">
    {
      domaines.map((d, i) => (
        <a href={d.lien} class={`group flex flex-col monte monte-${i + 1}`}>
          <span class="block overflow-hidden">
          <img
            src={`/galerie/${d.photo}-1400.webp`}
            srcset={`/galerie/${d.photo}-520.webp 520w, /galerie/${d.photo}-1400.webp 1400w`}
            sizes="(min-width: 768px) 33vw, 100vw"
            width={d.l}
            height={d.h}
            alt={d.alt}
            loading="lazy"
            decoding="async"
            class={`aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 ${d.cadrage}`}
          />
          </span>
          <div class={`flex flex-1 flex-col px-7 py-9 text-paper sm:px-9 ${d.fond}`}>
            {d.chiffre && (
              <p class="font-titre text-5xl font-semibold leading-none">{d.chiffre}</p>
            )}
            {d.chiffre && <p class="mt-2 text-sm text-paper/85">{d.unite}</p>}
            <h2 class={`font-titre text-2xl font-semibold ${d.chiffre ? 'mt-7' : ''}`}>{d.titre}</h2>
            <p class="mt-3 flex-1 leading-relaxed text-paper/90">{d.texte}</p>
            <span class="mt-7 text-sm font-medium text-paper/90 group-hover:underline">
              En savoir plus →
            </span>
          </div>
        </a>
      ))
    }
  </section>

  {/*
    LE MOT DU COORDONNATEUR.

    🔑 Rien n'est ecrit a sa place. Les deux citations sont de lui, mot pour mot,
    parues dans Sud Quotidien le 28/02/2026, et la source est affichee sous le
    texte. C'est le principe de charity: water repris du cahier de references —
    une affirmation, une preuve a cote — et c'est ce qui rend le bloc opposable :
    un bailleur peut aller verifier.

    Sa fonction exacte est « coordonnateur global du Consortium Dekkandoo »,
    telle qu'ecrite dans l'article. Pas « dirigeant ».

    ⚠️ Meme sourcee, une citation reprise sur le site officiel de l'organisation
    se lit comme une parole institutionnelle : a signaler a Khaly avant la mise
    en ligne. Ce n'est plus une question d'exactitude, c'est une politesse.
  */}
  {/* PANNEAU PASSE EN CLAIR LE 15/08, et c'est le fond qui a bouge, pas la
      couleur. Saibo voulait le brun du logo sur ce bloc ; sur le vert fonce ce
      brun mesure 1,02:1, il y est invisible. Plutot que d'inventer une couleur
      qui n'est pas la sienne, on met le bloc sur le creme — ou le vrai
      `#683c10` donne 8,61:1. C'est aussi ce que fait leur propre film : vert et
      brun sur blanc. Meme regle que « on ne retouche jamais le logo d'un
      client : si ca ne ressort pas, on change le fond ». */}
  <section class="bg-paper-2 py-16 text-ink sm:py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Photo
          cle="khaly"
          tailles="(min-width: 1024px) 40vw, 100vw"
          class="aspect-[4/5] w-full rounded-xl object-cover object-[52%_26%]"
        />
      </div>

      <figure class="lg:col-span-7">
        <blockquote class="font-serif text-2xl leading-snug text-forest sm:text-4xl">
          « Ici, le taux de remboursement du crédit est de 100 %. Parce que pour
          nous, il est hors de question de ne pas rembourser un crédit. »
        </blockquote>
        <p class="mt-6 max-w-xl leading-relaxed text-ink-2">
          « On a juste sélectionné 400 femmes bénéficiaires, mais on a
          8 000 femmes dans notre base de données. »
        </p>
        <figcaption class="mt-7 border-t border-line pt-5">
          <span class="block font-serif text-lg text-accent">Abdou Khaly Mbodj</span>
          <span class="mt-1 block text-sm text-ink-3">
            Coordonnateur global du Consortium Dëkkandoo
          </span>
          <a
            href="https://fr.allafrica.com/stories/202602280036.html"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-block font-mono text-xs text-accent hover:underline"
          >
            Sud Quotidien, 28 février 2026 ↗
          </a>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* PROGRAMMES — REFONTE 11/2026 : deux recits avec photo, sans pastilles ni
      cases de chiffres en pied de carte. Les dates tiennent dans une ligne. */}
  <section id="programmes" class="scroll-mt-24 bg-paper-2 pt-20">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="font-serif text-3xl leading-tight text-forest sm:text-4xl">
        Deux programmes en cours
      </h2>

      <div class="revele mt-12 grid gap-14 lg:grid-cols-2">
        <article class="group">
          <span class="block overflow-hidden rounded-lg">
          <img
            src="/galerie/g03-1400.webp"
            srcset="/galerie/g03-520.webp 520w, /galerie/g03-1400.webp 1400w"
            sizes="(min-width: 1024px) 45vw, 100vw"
            width="1400"
            height="933"
            alt="Remise d’un document devant la bannière du Projet de Renforcement de la Nutrition à Saint-Louis"
            loading="lazy"
            decoding="async"
            class="aspect-[3/2] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          </span>
          <h3 class="mt-6 font-titre text-2xl font-semibold text-forest">PRN2S</h3>
          <p class="mt-1 text-sm text-ink-3">
            Avec Plan International Sénégal · décembre 2024 → novembre 2027 · 20 sites de suivi
          </p>
          <p class="mt-4 leading-relaxed text-ink-2">
            Un programme de trois ans pour améliorer l’état nutritionnel et
            sanitaire des enfants de 0 à 59 mois, en renforçant les capacités
            productives des ménages et l’accès effectif aux soins.
          </p>
        </article>

        <article class="group">
          <span class="block overflow-hidden rounded-lg">
          <Photo
            cle="remise-produits"
            tailles="(min-width: 1024px) 45vw, 100vw"
            class="aspect-[3/2] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          </span>
          <h3 class="mt-6 font-titre text-2xl font-semibold text-forest">Ndieumbeutt</h3>
          <p class="mt-1 text-sm text-ink-3">
            Avec la Fondation Roi Baudouin et Nous Cims · lancé en 2026 · 400 femmes de 18 à 35 ans
          </p>
          <p class="mt-4 leading-relaxed text-ink-2">
            Accompagner les femmes dans la construction d’activités durables, de
            la production agricole à l’élevage, avec formation, financement et
            suivi sur la durée.
          </p>
        </article>
      </div>

      <p class="mt-12">
        <a
          href="/programmes/"
          class="rounded-full bg-forest px-7 py-3 font-medium text-paper transition-colors hover:bg-forest-2"
        >
          Les deux programmes en détail
        </a>
      </p>
    </div>

    {/* Le grand moment photo du recit (Farm Africa finit sur une personne).
        Le texte vit dans un panneau opaque qui chevauche l'image, jamais dessus. */}
    <div class="revele relative mt-20">
      <Photo
        cle="champ-recolte"
        tailles="100vw"
        class="h-[22rem] w-full object-cover object-[50%_14%] sm:h-[30rem] lg:h-[34rem]"
      />
      <div class="mx-auto max-w-6xl px-5">
        <div class="relative -mt-24 max-w-xl bg-forest p-8 text-paper sm:-mt-32 sm:p-10">
          <p class="font-serif text-2xl leading-snug sm:text-3xl">
            Chaque femme choisit son activité ; l’association de son village la
            finance, et le Consortium la suit.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-paper/80">
            Production maraîchère, élevage, transformation : chaque financement
            est adossé à une activité suivie dans la durée.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* IMPACT — REFONTE 11/2026 : les chiffres dans une phrase, plus en cases
      (releve du 06/11, signe n.3). Puis « Ils en ont parle », repris de
      GiveDirectly : deux sources que n'importe qui peut ouvrir. */}
  <section id="impact" class="scroll-mt-24 py-20 sm:py-24">
    <div class="mx-auto max-w-4xl px-5">
      <h2 class="font-serif text-3xl leading-tight text-forest sm:text-4xl">
        Ce que les programmes ont produit
      </h2>
      <p class="revele mt-8 font-serif text-2xl leading-relaxed text-ink sm:text-3xl sm:leading-relaxed">
        <strong class="font-semibold text-accent">3 219</strong> initiatives
        financées, <strong class="font-semibold text-accent">250</strong> femmes
        formées à la transformation et à la production,
        <strong class="font-semibold text-accent">5 567</strong> produits
        d’hygiène fabriqués sur place, et
        <strong class="font-semibold text-accent">75</strong> associations
        d’épargne dotées en 2026.
      </p>
      <p class="mt-8">
        <a href="/impact/" class="font-medium text-accent hover:underline">
          Le détail et les sources de chaque chiffre →
        </a>
      </p>

      <div class="mt-16 border-t border-line pt-10">
        <h3 class="font-titre text-lg font-semibold text-forest">Ils en ont parlé</h3>
        <ul class="mt-6 grid gap-8 sm:grid-cols-2">
          <li>
            <a
              href="https://fr.allafrica.com/stories/202602280036.html"
              target="_blank"
              rel="noopener noreferrer"
              class="group block"
            >
              <span class="block text-sm text-ink-3">Sud Quotidien · 28 février 2026</span>
              <span class="mt-2 block font-serif text-lg leading-snug text-forest group-hover:underline">
                « Lancement du programme E4Y pour financer 400 femmes à plus de 200 millions » ↗
              </span>
            </a>
          </li>
          <li>
            <a
              href="https://chaireunesco-es.org/2026/10/30/senegal-le-consortium-dekkandoo-mobilise-les-ecoles-pour-promouvoir-la-nutrition-et-la-sante-des-enfants/"
              target="_blank"
              rel="noopener noreferrer"
              class="group block"
            >
              <span class="block text-sm text-ink-3">Chaire UNESCO Éducations et Santé · 30 octobre 2026</span>
              <span class="mt-2 block font-serif text-lg leading-snug text-forest group-hover:underline">
                « Le consortium Dëkkandoo mobilise les écoles pour promouvoir la nutrition et la santé des enfants » ↗
              </span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* ACTUALITÉS */}
  <section id="actualites" class="scroll-mt-24 bg-paper-2 py-20">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="font-serif text-3xl leading-tight text-forest sm:text-4xl">Actualités</h2>

      <div class="revele mt-12 grid gap-6 md:grid-cols-3">
        {
          // Les 3 plus recentes seulement : la grille fait 3 colonnes, une 4e carte
          // resterait seule sur sa ligne. Les autres sont sur /actualites/.
          ACTUALITES.slice(0, 3).map((a) => (
            <article class="overflow-hidden rounded-xl border border-line bg-card transition-shadow hover:shadow-lg">
              <a href={`/actualites/${a.slug}/`} class="block">
                <Photo
