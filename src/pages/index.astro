<style>
  /* ---------------------------------------------------------------------------
     LE GESTE DU HEROS — cahier de references, regle n.2 : un seul effet
     d'animation sur toute la page d'accueil, place sur le mot qui porte le sens.

     Trois temps qui se lisent comme un seul mouvement :
       1. la photo se devoile de gauche a droite (elle emerge de derriere le
          panneau vert, qui la chevauche a partir de `lg`) ;
       2. le texte du panneau monte, ligne par ligne ;
       3. « l'avenir » passe du creme a l'or, en dernier. C'est la seule chose
          que le visiteur doit retenir, donc c'est la derniere qui bouge.

     POURQUOI ZERO JAVASCRIPT. Le dispositif `.revele` du layout est pilote par
     un observateur au defilement : il lui FAUT du JS, d'ou la classe `.js` qui
     protege son `opacity: 0`. Ici rien de tel n'est necessaire — l'animation se
     declenche au chargement, ce que CSS sait faire seul. Farm Africa, dont le
     heros a inspire celui-ci, charge jQuery et une video de 3,75 Mo pour son
     effet : c'est plus lourd que les 22 photos de ce site reunies, et ils le
     coupent purement et simplement sur mobile. Ici l'effet coute 0 octet et
     s'affiche donc partout, telephone Android compris.

     LE GARDE-FOU, et il tient dans un mot : `backwards`. L'etat FINAL est
     l'etat normal des elements, ecrit dans le balisage Tailwind ; les
     `@keyframes` ne decrivent que le point de DEPART. Un navigateur qui
     n'animerait pas affiche donc la page terminee, jamais une page vide — le
     defaut inverse de `.revele { opacity: 0 }`.

     SUR TELEPHONE, RIEN. Arbitrage de Saibo le 11/08 : le heros mobile reste
     exactement celui du matin, sans aucune animation. Ce geste ne sert donc
     plus que de repli sur grand ecran, pour les navigateurs qui ne savent pas
     lier une animation au defilement — les autres le rejouent a l'arrivee du
     heros (plus bas).

     Et rien ne bouge pour qui a demande moins d'animation dans son systeme.
     --------------------------------------------------------------------------- */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .heros-photo {
      animation: heros-volet 900ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .heros-panneau > * {
      animation: heros-monte 700ms ease-out backwards;
    }
    .heros-panneau > *:nth-child(1) {
      animation-delay: 260ms;
    }
    .heros-panneau > *:nth-child(2) {
      animation-delay: 360ms;
    }
    .heros-panneau > *:nth-child(3) {
      animation-delay: 460ms;
    }
    .heros-panneau > *:nth-child(4) {
      animation-delay: 560ms;
    }

    /* Le dernier temps. Il demarre apres que le titre a fini de monter. */
    .heros-accent {
      animation: heros-or 700ms ease-out 900ms backwards;
    }
  }

  @keyframes heros-volet {
    from {
      clip-path: inset(0 0 0 100%);
    }
  }

  @keyframes heros-monte {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Pas de `to` : la valeur d'arrivee est celle de l'element, c'est-a-dire le
     brun de `text-accent` deja pose dans le balisage.

     🔴 LE DEPART A CHANGE LE 15/08, ET C'ETAIT UN BUG, PAS UN GOUT. Cette
     animation partait du CREME, ce qui allait tant que le panneau etait vert.
     Le panneau est passe au creme : le mot devenait alors creme sur creme,
     mesure a 1,00:1 — litteralement invisible tant que le defilement n'avait
     pas atteint sa plage. Le defaut a ete trouve par un balayage de contraste
     sur les sept pages, pas a l'oeil : il ne se voyait pas, il se mesurait.

     Le depart est donc le VERT du titre. Le mot commence de la meme couleur que
     le reste de la phrase et se rechauffe jusqu'au brun — c'est une revelation
     qui a du sens, et elle est lisible a chaque instant. */
  @keyframes heros-or {
    from {
      color: var(--color-forest);
    }
  }

  /* ---------------------------------------------------------------------------
     LA SECTION FILM
     --------------------------------------------------------------------------- */
  /* Le rapport est porte par le CADRE et non par la video : la place est ainsi
     reservee avant que le fichier n'arrive, et la page ne saute pas. L'aplat
     vert evite le rectangle blanc pendant le chargement. */
  .film {
    position: relative;
    aspect-ratio: 16 / 9;
    background-color: var(--color-forest);
  }

  .film-video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    /* La source est en 16/9 comme le cadre : `cover` ne rogne donc rien. Il
       n'est la que pour le jour ou la source cesserait de l'etre. */
    object-fit: cover;
  }

  /* Meme couple que les boutons du heros : aplat brun, signe creme, 8,61:1
     entre les deux. Le filet creme lui rend son contour sur une image sombre. */
  .film-son {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background-color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-paper) 55%, transparent);
    border-radius: 50%;
    color: var(--color-paper);
    cursor: pointer;
    transition: background-color 0.16s;
  }
  .film-son:hover {
    background-color: var(--color-accent-2);
  }
  .film-son:focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: 3px;
  }
  .film-son svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* L'etat par defaut est MUET : la barre se voit, les ondes non. */
  .film-son .film-son-ondes {
    display: none;
  }
  .film-son[aria-pressed='true'] .film-son-barre {
    display: none;
  }
  .film-son[aria-pressed='true'] .film-son-ondes {
    display: block;
  }
</style>

<!-- Le film ne se telecharge que si on descend jusqu'a lui. `IntersectionObserver`
     avec une marge de 300 px : le fichier commence a arriver juste avant que la
     section n'entre a l'ecran, donc sans attente visible, et jamais pour un
     visiteur qui reste en haut de page. -->
<script is:inline>
  (() => {
    const cadre = document.querySelector('.film');
    if (!cadre) return;
    const video = cadre.querySelector('.film-video');
    const bouton = cadre.querySelector('.film-son');
    if (!video) return;

    const allumer = () => {
      if (video.dataset.src) {
        video.poster = video.dataset.poster;
        video.src = video.dataset.src;
        delete video.dataset.src;
      }
      video.play().catch(() => {
        /* Lecture refusee : le poster reste, et la section garde son sens. */
      });
    };

    if (typeof IntersectionObserver === 'function') {
      const oeil = new IntersectionObserver(
        (entrees) => {
          for (const e of entrees) {
            if (!e.isIntersecting) continue;
            allumer();
            oeil.disconnect();
          }
        },
        { rootMargin: '300px' }
      );
      oeil.observe(cadre);
    } else {
      allumer();
    }

    if (bouton) {
      const etiquette = bouton.querySelector('.sr-only');
      bouton.addEventListener('click', () => {
        allumer();
        video.muted = !video.muted;
        const actif = !video.muted;
        bouton.setAttribute('aria-pressed', actif ? 'true' : 'false');
        etiquette.textContent = actif
          ? 'Couper le son de la vidéo'
          : 'Activer le son de la vidéo';
      });
    }
  })();
</script>
