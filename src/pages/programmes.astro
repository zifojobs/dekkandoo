---
import Base from '../layouts/Base.astro';
import EnTetePage from '../components/EnTetePage.astro';
import Photo from '../components/Photo.astro';
---

<Base
  titre="Nos programmes"
  description="PRN2S, renforcement nutritionnel et sanitaire des enfants de 0 à 59 mois avec Plan International Sénégal. Ndieumbeutt, accompagnement de 400 femmes vers une activité durable."
>
  <EnTetePage
    rubrique="Nos programmes"
    titre="PRN2S et Ndieumbeutt"
    intro="Le premier suit la nutrition des enfants de 0 à 59 mois avec Plan International Sénégal, jusqu'en novembre 2027. Le second accompagne 400 femmes de 18 à 35 ans vers une activité durable."
  />

  {/* PRN2S */}
  <section class="mx-auto max-w-6xl px-5 py-16">
    <span class="inline-block rounded-full bg-forest px-3 py-1 font-mono text-xs text-paper">
      En cours · 2024-2027
    </span>
    <h2 class="mt-5 font-serif text-3xl text-forest sm:text-4xl">PRN2S</h2>
    <p class="mt-2 text-lg text-ink-3">
      Projet de Renforcement de la Nutrition à Saint-Louis du Sénégal
    </p>

    <div class="mt-9 grid gap-10 lg:grid-cols-12">
      <div class="space-y-5 leading-relaxed text-ink-2 lg:col-span-7">
        <p>
          Conduit avec <strong class="text-forest">Plan International Sénégal</strong>,
          le PRN2S est un programme de trois ans qui vise à améliorer l’état
          nutritionnel et sanitaire des enfants de 0 à 59 mois, en renforçant
          simultanément les capacités productives des ménages et l’accès effectif
          aux soins.
        </p>
        <p>
          Le suivi est communautaire : les enfants sont pesés chaque mois sur des
          sites répartis dans les zones d’intervention, la malnutrition aiguë est
          dépistée sur place, et les familles concernées sont accompagnées
          individuellement. Les données remontent ensuite dans le rapport
          semestriel remis au bailleur.
        </p>
        <p>
          Ce dispositif s’appuie sur les <strong class="text-forest">Comités de
          Développement de Santé</strong> et sur l’initiative Diapalanté Fadju,
          qui rapproche les familles vulnérables des postes de santé existants.
        </p>
      </div>

      <dl class="grid gap-px self-start overflow-hidden rounded-xl border border-line bg-line lg:col-span-5">
        <div class="bg-card p-7">
          <dt class="font-mono text-2xl text-earth">36 mois</dt>
          <dd class="mt-1 text-sm text-ink-3">décembre 2024 → novembre 2027</dd>
        </div>
        <div class="bg-card p-7">
          <dt class="font-mono text-2xl text-earth">20 sites</dt>
          <dd class="mt-1 text-sm text-ink-3">de suivi communautaire</dd>
        </div>
        <div class="bg-card p-7">
          <dt class="font-mono text-2xl text-earth">0 à 59 mois</dt>
          <dd class="mt-1 text-sm text-ink-3">tranche d’âge suivie</dd>
        </div>
      </dl>
    </div>
  </section>

  {/* Bandeau photo — dispositif One Acre Fund : le texte vit dans un panneau
      opaque qui chevauche l'image, jamais sur l'image. */}
  <div class="revele relative">
    <Photo
      cle="champ-recolte"
      tailles="100vw"
      class="h-[20rem] w-full object-cover object-[50%_14%] sm:h-[26rem]"
    />
    <div class="mx-auto max-w-6xl px-5">
      <div class="relative -mt-20 max-w-xl bg-forest p-8 text-paper sm:-mt-24 sm:p-10">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-paper/85">Sur le terrain</p>
        <p class="mt-4 font-serif text-2xl leading-snug sm:text-3xl">
          Chaque femme choisit son activité ; l’association de son village la
          finance, et le Consortium la suit.
        </p>
      </div>
    </div>
  </div>

  {/* ---------------------------------------------------------------------------
      LE FILM — une section a lui, depuis le 15/08.
      DEPLACE DE L'ACCUEIL LE 08/11/2026 (Saibo) : le heros de l'accueil joue
      desormais une boucle tiree de ce meme film ; le film entier vit ici, a
      cote du programme qu'il raconte (PRN2S, « Nourrir l'avenir »).

      Il vivait jusqu'ici dans la lucarne de l'ecran d'intro, qui s'ouvrait au
      defilement. Ce dispositif est supprime : Saibo voulait le film ENTIER et
      en pleine largeur, et la geometrie s'y opposait. Une video pleine largeur
      en 16/9 sur un ecran 1920x1080 fait exactement 1080 px de haut, soit toute
      la fenetre — l'en-tete ne pouvait pas cohabiter avec elle.

      Ici, plus rien ne s'y oppose : la section fait la largeur de la page, le
      film garde son rapport, et on le voit en entier sans qu'il ait a se
      partager l'ecran avec autre chose.

      LE POIDS N'EST PAYE QUE PAR QUI DESCEND JUSQU'ICI. Ni `src` ni `poster` ne
      sont dans le balisage : c'est un observateur qui les pose quand la section
      approche de l'ecran.

      Ce que ca donne, mesure : sur TELEPHONE la section commence a y = 1307
      pour un ecran de 844, donc zero requete et zero octet tant qu'on ne
      descend pas — et c'est la que ca compte, le public etant majoritairement
      mobile et en donnees payantes. Sur un grand ecran, en revanche, la section
      est deja visible au premier coup d'oeil et se charge aussitot : c'est
      normal, elle y est le deuxieme element de la page.

      Le cadre porte son rapport 16/9 et un aplat vert : la place est reservee
      avant le chargement, donc la page ne saute jamais.
      --------------------------------------------------------------------------- */}
  <section class="bg-forest" aria-labelledby="film-titre">
    <h2 id="film-titre" class="sr-only">Le film du PRN2S : Nourrir l’avenir</h2>
    <div class="film">
      <video
        class="film-video"
        data-src="/video/actions.mp4?v=2"
        data-poster="/video/actions-poster.jpg"
        muted
        playsinline
        preload="none"></video>

      {/* LE FILM ENTIER, ET PLUS UN EXTRAIT — 15/08. La page ne servait que les
          70 premieres secondes, un decoupage herite de la lucarne de l'ecran
          d'intro, qui n'a plus lieu d'etre dans une section dediee.

          `loop` est retire avec : on ne remet pas en boucle un film de cinq
          minutes, on le laisse finir.

          36 Mo, mais l'atome `moov` est en tete du fichier (`+faststart`) :
          le lecteur demarre sur les premiers paquets au lieu d'attendre le
          telechargement complet. Avec `preload="none"`, un visiteur qui ne
          descend pas jusqu'ici ne telecharge toujours RIEN.

          `?v=2` parce que le fichier garde son nom : sans lui, un visiteur qui
          a l'extrait en cache continuerait de le voir. */}

      {/* La video demarre MUETTE, et ne peut pas etre autrement : aucun
          navigateur n'autorise une lecture automatique sonore. Le bouton rend
          le son possible, il ne l'impose pas.

          Un vrai <button> : trouvable au clavier, annonce par un lecteur
          d'ecran, et `aria-pressed` porte l'etat que le CSS suit — une seule
          source de verite. */}
      <button class="film-son" type="button" aria-pressed="false">
        <span class="sr-only">Activer le son de la vidéo</span>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 9.5v5h3.5L12 18V6L7.5 9.5H4z" />
          <path class="film-son-barre" d="M16 9.5l4.5 5m0-5l-4.5 5" />
          <path class="film-son-ondes" d="M15.8 9.4a3.6 3.6 0 010 5.2M18.6 7.2a7.2 7.2 0 010 9.6" />
        </svg>
      </button>
    </div>
  </section>

  {/* NDIEUMBEUTT */}
  <section class="bg-paper-2">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <span class="inline-block rounded-full bg-paper px-3 py-1 font-mono text-xs text-ink">
        Lancé en 2026
      </span>
      <h2 class="mt-5 font-serif text-3xl text-forest sm:text-4xl">Ndieumbeutt</h2>
      <p class="mt-2 text-lg text-ink-3">
        Un financement au service de l’autonomisation féminine
      </p>

      <div class="mt-9 grid gap-10 lg:grid-cols-12">
        <div class="space-y-5 leading-relaxed text-ink-2 lg:col-span-7">
          <p>
            Ndieumbeutt accompagne <strong class="text-forest">400 femmes de 18
            à 35 ans</strong> dans la construction d’activités durables, de la
            production agricole à l’élevage, avec formation, financement et suivi
            sur la durée. Le programme est conduit dans le cadre de
            <strong class="text-forest"> E4Y</strong>, avec le soutien de la
            Fondation Roi Baudouin et de Nous Cims.
          </p>
          <p>
            Le financement passe par les associations villageoises d’épargne et
            de crédit, qui décident elles-mêmes de l’affectation des montants
            selon les besoins de leurs membres. La formation, elle, est assurée
            en partenariat avec Entrepreneurial Solution Partners (ESP).
          </p>
          <p>
            Le nombre de bénéficiaires n’est pas une limite de la demande, mais
            du financement disponible : le Consortium compte
            <strong class="text-forest"> 8 000 femmes</strong> dans sa base de
            données.
          </p>
        </div>

        <dl class="grid gap-px self-start overflow-hidden rounded-xl border border-line bg-line lg:col-span-5">
          <div class="bg-card p-7">
            <dt class="font-mono text-2xl text-earth">400</dt>
            <dd class="mt-1 text-sm text-ink-3">femmes accompagnées</dd>
          </div>
          <div class="bg-card p-7">
            <dt class="font-mono text-2xl text-earth">18-35 ans</dt>
            <dd class="mt-1 text-sm text-ink-3">public visé</dd>
          </div>
          <div class="bg-card p-7">
            <dt class="font-mono text-2xl text-earth">100 %</dt>
            <dd class="mt-1 text-sm text-ink-3">
              taux de remboursement des crédits
              <a
                href="https://fr.allafrica.com/stories/202602280036.html"
                target="_blank"
                rel="noopener noreferrer"
                class="ml-1 text-accent hover:underline"
              >
                (source)
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href="/impact/"
          class="rounded-full bg-forest px-7 py-3 font-medium text-paper transition-colors hover:bg-forest-2"
        >
          Voir les résultats
        </a>
        <a
          href="/actualites/"
          class="rounded-full border border-line px-7 py-3 font-medium text-forest transition-colors hover:border-forest hover:bg-forest hover:text-paper"
        >
          Actualités du terrain
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------------------------
     LA SECTION FILM
     --------------------------------------------------------------------------- */
  /* Le rapport est porte par le CADRE et non par la video : la place est ainsi
     reservee avant que le fichier n'arrive, et la page ne saute pas. L'aplat
     vert evite le rectangle blanc pendant le chargement. */
  .film {
    position: relative;
    aspect-ratio: 16 / 9;
    background-color: var(--color-forest);
  }

  .film-video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    /* La source est en 16/9 comme le cadre : `cover` ne rogne donc rien. Il
       n'est la que pour le jour ou la source cesserait de l'etre. */
    object-fit: cover;
  }

  /* Meme couple que les boutons du heros : aplat brun, signe creme, 8,61:1
     entre les deux. Le filet creme lui rend son contour sur une image sombre. */
  .film-son {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background-color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-paper) 55%, transparent);
    border-radius: 50%;
    color: var(--color-paper);
    cursor: pointer;
    transition: background-color 0.16s;
  }
  .film-son:hover {
    background-color: var(--color-accent-2);
  }
  .film-son:focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: 3px;
  }
  .film-son svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* L'etat par defaut est MUET : la barre se voit, les ondes non. */
  .film-son .film-son-ondes {
    display: none;
  }
  .film-son[aria-pressed='true'] .film-son-barre {
    display: none;
  }
  .film-son[aria-pressed='true'] .film-son-ondes {
    display: block;
  }
</style>

<!-- Le film ne se telecharge que si on descend jusqu'a lui. `IntersectionObserver`
     avec une marge de 300 px : le fichier commence a arriver juste avant que la
     section n'entre a l'ecran, donc sans attente visible, et jamais pour un
     visiteur qui reste en haut de page. -->
<script is:inline>
  (() => {
    const cadre = document.querySelector('.film');
    if (!cadre) return;
    const video = cadre.querySelector('.film-video');
    const bouton = cadre.querySelector('.film-son');
    if (!video) return;

    const allumer = () => {
      if (video.dataset.src) {
        video.poster = video.dataset.poster;
        video.src = video.dataset.src;
        delete video.dataset.src;
      }
      video.play().catch(() => {
        /* Lecture refusee : le poster reste, et la section garde son sens. */
      });
    };

    if (typeof IntersectionObserver === 'function') {
      const oeil = new IntersectionObserver(
        (entrees) => {
          for (const e of entrees) {
            if (!e.isIntersecting) continue;
            allumer();
            oeil.disconnect();
          }
        },
        { rootMargin: '300px' }
      );
      oeil.observe(cadre);
    } else {
      allumer();
    }

    if (bouton) {
      const etiquette = bouton.querySelector('.sr-only');
      bouton.addEventListener('click', () => {
        allumer();
        video.muted = !video.muted;
        const actif = !video.muted;
        bouton.setAttribute('aria-pressed', actif ? 'true' : 'false');
        etiquette.textContent = actif
          ? 'Couper le son de la vidéo'
          : 'Activer le son de la vidéo';
      });
    }
  })();
</script>

