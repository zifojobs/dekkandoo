---
import Base from '../../layouts/Base.astro';
import EnTetePage from '../../components/EnTetePage.astro';
import Photo from '../../components/Photo.astro';
import { ACTUALITES } from '../../actualites';
---

<Base
  titre="Actualités"
  description="Remises de financement, formations, lancements de programme : ce que le Consortium Dëkkandoo conduit sur le terrain, dans les six communes du département de Saint-Louis."
>
  <EnTetePage
    rubrique="Actualités"
    titre="Ce qui se passe sur le terrain"
    intro="Nos équipes documentent chaque étape, sur le terrain comme en cérémonie. Chaque publication a sa propre adresse : elle se partage telle quelle."
  />

  <div class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid gap-8 md:grid-cols-3">
      {
        ACTUALITES.map((a) => (
          <article class="overflow-hidden rounded-xl border border-line bg-card transition-shadow hover:shadow-lg">
            <a href={`/actualites/${a.slug}/`} class="block">
              <Photo
                cle={a.photo}
                tailles="(min-width: 768px) 33vw, 100vw"
                class={`h-52 w-full object-cover ${a.cadrage}`}
              />
              <div class="p-6">
                <time
                  datetime={a.dateIso}
                  class="font-mono text-xs uppercase tracking-wider text-ink-3"
                >
                  {a.date}
                </time>
                <h2 class="mt-3 font-serif text-lg leading-snug text-forest">{a.titre}</h2>
                <p class="mt-3 text-sm leading-relaxed text-ink-2">{a.chapo}</p>
                <span class="mt-5 inline-block font-mono text-xs uppercase tracking-wider text-leaf">
                  Lire l'article →
                </span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</Base>
