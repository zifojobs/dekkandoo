---
import Base from '../layouts/Base.astro';
import EnTetePage from '../components/EnTetePage.astro';
import Photo from '../components/Photo.astro';

const chiffres = [
  { n: '250', l: 'femmes formées à la transformation et à la production' },
  { n: '3 219', l: 'initiatives entrepreneuriales financées' },
  { n: '5 567', l: "produits d'hygiène fabriqués localement" },
  { n: '75', l: "associations d'épargne dotées en 2026" },
  { n: '18,75 M', l: "FCFA remis aux associations de Gandon" },
  { n: '125', l: 'bénéficiaires ayant achevé leur parcours de formation' },
];
---

<Base
  titre="Notre impact"
  description="250 femmes formées, 3 219 initiatives financées, 18,75 millions FCFA remis à 75 associations d'épargne de Gandon, et un taux de remboursement des crédits de 100 %."
>
  <EnTetePage
    rubrique="Notre impact"
    titre="250 femmes formées, 3 219 initiatives financées"
    intro="Les chiffres de cette page viennent des rapports de suivi remis aux bailleurs et de la presse. Un partenaire peut demander le document derrière chacun."
  />

  <section class="mx-auto max-w-6xl px-5 py-16">
    {/* REFONTE 11/2026 : un registre en lignes plutot que six cases (releve du
        06/11, signe n.3). Le chiffre et sa phrase se lisent d'un trait. */}
    <dl class="revele max-w-3xl border-t border-line">
      {
        chiffres.map(({ n, l }) => (
          <div class="flex items-baseline gap-6 border-b border-line py-5">
            <dt class="w-28 shrink-0 font-titre text-3xl font-semibold text-accent sm:w-36 sm:text-4xl">{n}</dt>
            <dd class="leading-relaxed text-ink-2">{l}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* Le chiffre qui parle le plus a un bailleur, traite seul et source.
      Principe charity: water du cahier de references — une affirmation, une
      preuve a cote. Ici la preuve est un article de presse consultable. */}
  <section class="bg-forest py-16 text-paper sm:py-20">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="font-titre text-7xl font-semibold text-paper sm:text-8xl">100 %</p>
          <p class="mt-4 text-lg text-paper/85">
            de remboursement des crédits accordés
          </p>
        </div>
        <p class="text-lg leading-relaxed text-paper/85 lg:col-span-7">
          Le chiffre est donné par Abdou Khaly Mbodj, coordonnateur global du
          Consortium Dëkkandoo, dans
          <a
            href="https://fr.allafrica.com/stories/202602280036.html"
            target="_blank"
            rel="noopener noreferrer"
            class="text-paper underline hover:no-underline"
          >Sud Quotidien, le 28 février 2026 ↗</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="revele grid items-center gap-10 lg:grid-cols-2">
      <Photo
        cle="champ-equipe"
        tailles="(min-width: 1024px) 50vw, 100vw"
        class="w-full rounded-xl object-cover"
      />
      <div>
        <h2 class="font-serif text-2xl text-forest sm:text-3xl">
          Ce que nous rendons public
        </h2>
        <div class="mt-6 space-y-5 leading-relaxed text-ink-2">
          <p>
            Le Consortium est financé par des bailleurs internationaux et rend
            compte de son activité dans un rapport de suivi semestriel. Les
            chiffres présentés ici en sont issus, ou de la couverture presse de
            nos événements publics.
          </p>
          <p>
            Nous n’avançons aucun résultat que nous ne puissions rattacher à un
            document. Un partenaire qui souhaite consulter le détail d’un
            indicateur peut nous le demander.
          </p>
        </div>
        <a
          href="/contact/"
          class="mt-8 inline-block rounded-full border border-line px-7 py-3 font-medium text-forest transition-colors hover:border-forest hover:bg-forest hover:text-paper"
        >
          Demander un rapport
        </a>
      </div>
    </div>
  </section>
</Base>
