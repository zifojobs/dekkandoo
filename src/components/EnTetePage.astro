---
interface Props {
  /** Le sur-titre, en chasse fixe. Reprend le nom de la rubrique. */
  rubrique: string;
  titre: string;
  intro?: string;
}

const { rubrique, titre, intro } = Astro.props;
---

{/*
  En-tete commun aux six rubriques. Fond vert profond : il separe nettement
  l'en-tete du contenu, et donne a chaque page la meme assise que l'accueil sans
  qu'on ait a y remettre une photo.
*/}
<header class="bg-forest text-paper">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">{rubrique}</p>
    <h1 class="mt-5 max-w-4xl font-serif text-4xl leading-[1.1] sm:text-5xl">{titre}</h1>
    {
      intro && (
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-paper/85">{intro}</p>
      )
    }
  </div>
</header>
